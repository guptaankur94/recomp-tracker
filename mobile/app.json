{
  "expo": {
    "name": "Recomp",
    "slug": "recomp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recomp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.guptaankur.recomp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0E",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guptaankur.recomp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      "expo-audio",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Recomp reads your body weight from Apple Health, so weigh-ins from a smart scale show in your progress.",
          "NSHealthUpdateUsageDescription": "Recomp saves the weigh-ins you log to Apple Health.",
          "background": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.guptaankur.recomp.widget",
          "groupIdentifier": "group.com.guptaankur.recomp",
          "widgets": [
            {
              "name": "RecompWeek",
              "displayName": "Recomp",
              "description": "This week's workouts and what's next",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0C0E"
  }
}
